# LLM Provider Configuration
# Set LLM_PROVIDER to "mock", "openai", or "ollama"
LLM_PROVIDER=mock

# Model selection (e.g. gpt-4o, gpt-3.5-turbo, llama3:8b, mistral:7b)
LLM_MODEL=gpt-4o

# OpenAI Configuration (leave empty if using mock or ollama)
OPENAI_API_KEY=

# Ollama Configuration (leave empty if using mock or openai)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Persistent Storage Path (defaults to local sqlite db in memory/ or lab directory)
MEMORY_DB_PATH=agent_memory.db

# Execution Settings
MAX_ITERATIONS=5
MAX_DELEGATION_DEPTH=4
LOG_LEVEL=INFO

# LangGraph Multi-Agent Configuration (Module 4)
LANGGRAPH_RECURSION_LIMIT=10

# MLflow Tracking Configuration (Module 5)
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=academic_research_agent_evaluation
